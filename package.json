{
  "name": "ccp-xstate",
  "private": true,
  "type": "module",
  "description": "The v2 harness, built on XState. See CLAUDE.md.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "test": "node --test --test-skip-pattern=\"^cheap: \" \"test/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"packages/**/*.test.{js,mjs}\" \"plugins/**/*.test.{js,mjs}\" && node --test --test-concurrency=1 --test-name-pattern=\"^cheap: \" plugins/harness/test/capture.test.mjs",
    "check": "node plan/check.mjs"
  }
}
