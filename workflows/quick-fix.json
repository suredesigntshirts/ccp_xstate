{
  "id": "quick-fix",
  "description": "One issue to one merged PR. Context holds only refs the host observed and answers the person gave; every gate is a same-guard between them.",
  "initial": "briefing",
  "context": {
    "issue": null, "why": null, "base": null, "branch": null, "grant": null, "decision": null,
    "briefs": null, "pr": null, "notes": null, "verdict": null, "failure": null, "merge": null, "built": null, "rebuilt": null
  },
  "output": { "issue": "context.issue", "pr": "context.pr", "verdict": "context.verdict", "merge": "context.merge" },
  "states": {
    "briefing": {
      "meta": { "needs": ["hasIssue"] },
      "invoke": {
        "id": "brief", "src": "brief",
        "input": {
          "task": { "prompt": "task" },
          "issue": "context.issue", "why": "context.why", "base": "context.base", "branch": "context.branch"
        },
        "onDone": { "target": "building", "actions": [{ "type": "set", "params": { "briefs": "event.output" } }] },
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      }
    },
    "building": {
      "meta": { "needs": ["hasBriefs", "buildsLeft"] },
      "invoke": {
        "id": "build", "src": "build",
        "input": { "issue": "context.issue", "task": "context.briefs.builder", "base": "context.base", "branch": "context.branch", "previous": "context.pr", "verdict": "context.verdict", "failure": "context.failure" },
        "onDone": [
          { "target": "verifying", "description": "the host saw CI green on the claimed head at accept time", "actions": [{ "type": "set", "params": { "pr": "event.output.pr", "notes": "event.output.notes", "verdict": { "value": null }, "failure": { "value": null } } }, { "type": "set", "params": { "rebuilt": "context.built", "built": { "value": true } } }] },
          { "target": "checking", "actions": [{ "type": "set", "params": { "pr": "event.output.pr", "notes": "event.output.notes", "verdict": { "value": null }, "failure": { "value": null } } }, { "type": "set", "params": { "rebuilt": "context.built", "built": { "value": true } } }] }
        ],
        "onError": [
          { "target": "blocked", "guard": "blockedBuild", "description": "the first build returned blocked: the person may clear it and retry", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] },
          { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
        ]
      }
    },
    "checking": {
      "meta": { "needs": ["hasBriefs", "hasPr"] },
      "on": {
        "github.check_suite.completed": { "target": "verifying", "guard": "mine", "description": "CI green on the PR at head_sha, which becomes the head to verify", "actions": [{ "type": "set", "params": { "pr.at": "event.head_sha", "pr.green": { "value": true } } }] },
        "github.check_run.completed": [
          { "target": "building", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] },
          { "target": "replanning", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] }
        ],
        "github.pull_request.closed": { "target": "closedOutside", "guard": "closedOutside", "description": "the PR was merged or closed on GitHub by another path: the item ends, and its card is closed", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.closedOutside": "event.pr", "failure.outcome": "event.outcome" } }] }
      }
    },
    "verifying": {
      "meta": { "needs": ["hasBriefs", "hasPr", "ciGreen"] },
      "invoke": {
        "id": "verify", "src": "verify",
        "input": { "issue": "context.issue", "task": "context.briefs.verifier", "target": "context.pr", "checkout": "context.pr.checkout" },
        "onDone": [
          { "target": "awaitingGates", "description": "PASS at the head, and the PR changes CI config", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "merging", "description": "PASS at the head, and the parent granted the merge", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "awaitingMerge", "description": "PASS at the head", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "building", "guard": "failed", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "replanning", "description": "FAIL with no build left, or a verdict on another head", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] }
        ],
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      },
      "on": {
        "github.check_suite.completed": [
          { "guard": "sameHead", "description": "green again on the head being verified: nothing to do" },
          { "target": "reverifying", "guard": "mine", "description": "green on a new head: the head moved; reverifying (a twin of this state) starts a fresh verify run", "actions": [{ "type": "set", "params": { "pr.at": "event.head_sha", "pr.green": { "value": true }, "verdict": { "value": null } } }] }
        ],
        "github.check_run.completed": [
          { "target": "building", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] },
          { "target": "replanning", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] }
        ],
        "github.pull_request.closed": { "target": "closedOutside", "guard": "closedOutside", "description": "the PR was merged or closed on GitHub by another path: the item ends, and its card is closed", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.closedOutside": "event.pr", "failure.outcome": "event.outcome" } }] }
      }
    },
    "reverifying": {
      "meta": { "needs": ["hasBriefs", "hasPr", "ciGreen"] },
      "invoke": {
        "id": "verify", "src": "verify",
        "input": { "issue": "context.issue", "task": "context.briefs.verifier", "target": "context.pr", "checkout": "context.pr.checkout" },
        "onDone": [
          { "target": "awaitingGates", "description": "PASS at the head, and the PR changes CI config", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "merging", "description": "PASS at the head, and the parent granted the merge", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "awaitingMerge", "description": "PASS at the head", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "building", "guard": "failed", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] },
          { "target": "replanning", "description": "FAIL with no build left, or a verdict on another head", "actions": [{ "type": "set", "params": { "verdict": "event.output" } }] }
        ],
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      },
      "on": {
        "github.check_suite.completed": [
          { "guard": "sameHead", "description": "green again on the head being verified: nothing to do" },
          { "target": "verifying", "guard": "mine", "description": "green on a new head again: back to verifying, which starts a fresh verify run", "actions": [{ "type": "set", "params": { "pr.at": "event.head_sha", "pr.green": { "value": true }, "verdict": { "value": null } } }] }
        ],
        "github.check_run.completed": [
          { "target": "building", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] },
          { "target": "replanning", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] }
        ],
        "github.pull_request.closed": { "target": "closedOutside", "guard": "closedOutside", "description": "the PR was merged or closed on GitHub by another path: the item ends, and its card is closed", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.closedOutside": "event.pr", "failure.outcome": "event.outcome" } }] }
      }
    },
    "awaitingGates": {
      "meta": { "needs": ["verifiedHead", "gatesTouched"] },
      "after": { "checkBack": { "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)" } },
      "invoke": {
        "id": "ask", "src": "ask",
        "input": { "question": { "value": "This PR changes CI configuration, so its green CI is the builder's own. Merge it at the verified commit, CI change included?" }, "choices": { "value": ["approve CI change", "reject"] }, "pr": "context.verdict.pr", "verdict": "context.verdict", "notes": "context.notes" },
        "onDone": [
          { "target": "merging", "guard": "gatesApproved", "actions": [{ "type": "set", "params": { "decision": { "value": { "choice": "approve" } }, "decision.by": "event.output.by", "decision.gates": "context.verdict.pr.gates" } }] },
          { "target": "replanning", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] }
        ],
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      },
      "on": {
        "github.check_suite.completed": [
          { "guard": "sameHead" },
          { "target": "verifying", "guard": "mine", "actions": [{ "type": "set", "params": { "pr.at": "event.head_sha", "pr.green": { "value": true }, "verdict": { "value": null } } }] }
        ],
        "github.check_run.completed": [
          { "target": "building", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] },
          { "target": "replanning", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] }
        ],
        "github.pull_request.closed": { "target": "closedOutside", "guard": "closedOutside", "description": "the PR was merged or closed on GitHub by another path: the item ends, and its card is closed", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.closedOutside": "event.pr", "failure.outcome": "event.outcome" } }] }
      }
    },
    "awaitingMerge": {
      "meta": { "needs": ["verifiedHead"] },
      "after": { "checkBack": { "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)" } },
      "invoke": {
        "id": "ask", "src": "ask",
        "input": { "question": { "value": "Merge this PR at the verified commit?" }, "choices": { "value": ["approve", "reject"] }, "pr": "context.verdict.pr", "verdict": "context.verdict", "notes": "context.notes" },
        "onDone": [
          { "target": "merging", "description": "approved (merging needs approved)", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] },
          { "target": "replanning", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] }
        ],
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      },
      "on": {
        "github.check_suite.completed": [
          { "guard": "sameHead" },
          { "target": "verifying", "guard": "mine", "actions": [{ "type": "set", "params": { "pr.at": "event.head_sha", "pr.green": { "value": true }, "verdict": { "value": null } } }] }
        ],
        "github.check_run.completed": [
          { "target": "building", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] },
          { "target": "replanning", "guard": "redOnHead", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.check": "event.check", "failure.conclusion": "event.conclusion", "failure.sha": "event.head_sha", "failure.url": "event.details_url" } }] }
        ],
        "github.pull_request.closed": { "target": "closedOutside", "guard": "closedOutside", "description": "the PR was merged or closed on GitHub by another path: the item ends, and its card is closed", "actions": [{ "type": "set", "params": { "failure": { "value": null }, "failure.closedOutside": "event.pr", "failure.outcome": "event.outcome" } }] }
      }
    },
    "merging": {
      "meta": { "needs": ["verifiedHead", "ciGreen", "approved"] },
      "invoke": {
        "id": "merge", "src": "merge",
        "input": { "pr": "context.pr", "sha": "context.verdict.pr.at" },
        "onDone": { "target": "done", "actions": [{ "type": "set", "params": { "merge": "event.output" } }] },
        "onError": { "target": "replanning", "actions": [{ "type": "set", "params": { "failure": "event.error", "decision": "context.grant" } }] }
      }
    },
    "blocked": {
      "after": { "checkBack": { "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)" } },
      "invoke": {
        "id": "ask", "src": "ask",
        "input": { "question": { "value": "The build is blocked; what stopped it is below. Clear the block, then retry the build with the same briefs; or replan it with a written five whys; or drop it?" }, "choices": { "value": ["retry", "replan", "drop"] }, "failure": "context.failure" },
        "onDone": [
          { "target": "building", "guard": "retry", "description": "the same briefs again, with the block as failure; the retried build counts as the second", "actions": [{ "type": "set", "params": { "built": { "value": true } } }] },
          { "target": "briefing", "guard": "replan", "actions": [{ "type": "set", "params": { "why": "event.output.why", "built": { "value": null }, "rebuilt": { "value": null }, "pr": { "value": null }, "notes": { "value": null }, "verdict": { "value": null }, "failure": { "value": null }, "decision": "context.grant" } }] },
          { "target": "dropped", "guard": "drop", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] }
        ],
        "onError": "dropped"
      }
    },
    "replanning": {
      "after": { "checkBack": { "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)" } },
      "invoke": {
        "id": "ask", "src": "ask",
        "input": { "question": { "value": "This item stalled. Replan it with a written five whys, or drop it?" }, "choices": { "value": ["replan", "drop"] }, "verdict": "context.verdict", "failure": "context.failure" },
        "onDone": [
          { "target": "briefing", "guard": "replan", "actions": [{ "type": "set", "params": { "why": "event.output.why", "built": { "value": null }, "rebuilt": { "value": null }, "pr": { "value": null }, "notes": { "value": null }, "verdict": { "value": null }, "failure": { "value": null }, "decision": "context.grant" } }] },
          { "target": "dropped", "guard": "drop", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] }
        ],
        "onError": "dropped"
      }
    },
    "done": { "type": "final", "meta": { "needs": ["isMerged"] } },
    "dropped": { "type": "final" },
    "closedOutside": { "type": "final" }
  },
  "meta": {
    "delays": { "checkBack": 3600000 },
    "guards": {
      "hasIssue": ["context.issue.url", "context.issue.expect"],
      "hasBriefs": ["context.briefs.builder", "context.briefs.verifier"],
      "buildsLeft": [{ "path": "context.rebuilt", "in": [null] }],
      "hasPr": ["context.pr.url", "context.pr.at", "context.pr.key"],
      "ciGreen": [{ "path": "context.pr.green", "in": [true] }],
      "failed": [{ "path": "context.verdict.result", "in": ["FAIL"] }],
      "verifiedHead": [{ "path": "context.verdict.result", "in": ["PASS"] }, { "path": "context.verdict.pr.at", "same": "context.pr.at" }, { "path": "context.verdict.pr.url", "same": "context.pr.url" }],
      "gatesTouched": ["context.verdict.pr.gates"],
      "gatesApproved": [{ "path": "event.output.choice", "in": ["approve CI change"] }],
      "approved": [{ "path": "context.decision.choice", "in": ["approve"] }],
      "blockedBuild": ["event.blocked", { "path": "context.built", "in": [null] }],
      "retry": [{ "path": "event.output.choice", "in": ["retry"] }],
      "replan": [{ "path": "event.output.choice", "in": ["replan"] }, "event.output.why"],
      "drop": [{ "path": "event.output.choice", "in": ["drop"] }],
      "isMerged": ["context.merge.sha"],
      "mine": [{ "path": "event.pr", "same": "context.pr.key" }],
      "sameHead": [{ "path": "event.pr", "same": "context.pr.key" }, { "path": "event.head_sha", "same": "context.pr.at" }],
      "redOnHead": [{ "path": "event.pr", "same": "context.pr.key" }, { "path": "event.head_sha", "same": "context.pr.at" }, { "path": "event.conclusion", "in": ["failure", "timed_out", "cancelled", "action_required", "startup_failure"] }],
      "closedOutside": [{ "path": "event.pr", "same": "context.pr.key" }, { "path": "event.outcome", "in": ["merged", "closed"] }]
    },
    "input": {
      "type": "object",
      "required": ["issue"],
      "properties": {
        "issue": { "$ref": "#issue" },
        "base": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "grant": { "type": "object", "required": ["choice", "by"] },
        "decision": { "type": "object", "required": ["choice", "by"] }
      }
    },
    "events": {
      "github.check_suite.completed": { "type": "object", "required": ["head_sha", "pr"], "properties": { "head_sha": { "$ref": "#sha" }, "pr": { "type": "string", "minLength": 1 } } },
      "github.check_run.completed": { "type": "object", "required": ["check", "conclusion", "head_sha", "pr"], "properties": { "check": { "type": "string", "minLength": 1 }, "conclusion": { "type": "string" }, "head_sha": { "$ref": "#sha" }, "pr": { "type": "string", "minLength": 1 } } },
      "github.pull_request.closed": { "type": "object", "required": ["outcome", "pr"], "properties": { "outcome": { "type": "string" }, "pr": { "type": "string", "minLength": 1 } } }
    },
    "marks": {
      "brief": { "briefs": ["builder", "verifier"] },
      "build": { "refs": { "pr": "github-pr" } },
      "verify": { "verdicts": { "result": "PASS", "lines.0.result": "PASS" }, "refs": { "pr": "github-pr" } }
    },
    "actors": {
      "brief": {
        "prompt": "quick-fix/brief.md",
        "type": "object", "required": ["builder", "verifier"],
        "properties": {
          "builder": { "type": "string", "minLength": 1 },
          "verifier": { "type": "string", "minLength": 1 }
        }
      },
      "build": {
        "prompt": "quick-fix/build.md",
        "type": "object", "oneOf": [{ "required": ["pr"] }, { "required": ["blocked"] }],
        "properties": {
          "pr": { "$ref": "#prRef" },
          "blocked": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } },
          "notes": { "type": "string", "minLength": 1 }
        }
      },
      "verify": {
        "prompt": "quick-fix/verify.md",
        "type": "object", "required": ["result", "pr", "issue", "lines"],
        "properties": {
          "result": { "enum": ["PASS", "FAIL"] },
          "pr": { "$ref": "#prRef" },
          "issue": { "$ref": "#issue" },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#line" }, "covers": "issue.expect" }
        }
      },
      "ask": { "type": "object", "required": ["choice", "by"], "properties": { "choice": { "type": "string" }, "by": { "type": "string", "minLength": 1 }, "why": { "type": "string" } } },
      "merge": { "type": "object", "required": ["sha"], "properties": { "sha": { "$ref": "#sha" } } }
    },
    "schemas": {
      "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
      "prRef": { "type": "object", "required": ["url", "at"], "properties": { "url": { "type": "string", "minLength": 1, "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+/pull/[0-9]+/?$" }, "at": { "type": "string", "minLength": 40, "pattern": "^[0-9a-f]{40}$" } } },
      "issue": { "type": "object", "required": ["url", "expect"], "properties": { "url": { "type": "string", "minLength": 1 }, "expect": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
      "line": { "type": "object", "required": ["line", "result", "evidence"], "properties": { "line": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] }, "evidence": { "type": "string", "minLength": 1 } } }
    }
  }
}
