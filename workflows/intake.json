{
  "id": "intake",
  "description": "One request to a frozen issue, then one quick-fix child item. Shape writes the issue; challenge, seeing only the request and the issue, tries to break it before anything is built; shape revises at most twice before the card (plan/decisions/2026-11-05-wf-intake-ready.md).",
  "initial": "shaping",
  "context": {
    "request": null, "issue": null, "challenge": null, "answer": null, "failure": null, "revised": null, "rerevised": null, "fix": null, "decision": null
  },
  "output": { "issue": "context.issue", "challenge": "context.challenge", "fix": "context.fix" },
  "states": {
    "shaping": {
      "meta": { "needs": ["hasRequest"] },
      "invoke": {
        "id": "shape", "src": "shape",
        "input": {
          "task": { "prompt": "task" },
          "request": "context.request", "challenge": "context.challenge", "answer": "context.answer"
        },
        "onDone": { "target": "challenging", "description": "the host sets the issue's url from the request's", "actions": [{ "type": "set", "params": { "issue": "event.output.issue", "issue.url": "context.request.url" } }] },
        "onError": { "target": "stuck", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      }
    },
    "challenging": {
      "meta": { "needs": ["hasIssue"] },
      "invoke": {
        "id": "challenge", "src": "challenge",
        "input": {
          "task": { "prompt": "task" },
          "request": "context.request", "issue": "context.issue"
        },
        "onDone": [
          { "target": "fixing", "guard": "passed", "description": "every expect line held: the issue is frozen", "actions": [{ "type": "set", "params": { "challenge": "event.output", "failure": { "value": null } } }] },
          { "target": "shaping", "guard": "reviseAgain", "description": "FAIL with a revision left: shape again with this challenge", "actions": [{ "type": "set", "params": { "challenge": "event.output", "rerevised": "context.revised", "revised": { "value": true } } }] },
          { "target": "stuck", "description": "FAIL after two revisions", "actions": [{ "type": "set", "params": { "challenge": "event.output" } }] }
        ],
        "onError": { "target": "stuck", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      }
    },
    "stuck": {
      "after": { "checkBack": { "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)" } },
      "invoke": {
        "id": "ask", "src": "ask",
        "input": {
          "question": { "value": "Intake could not freeze an issue for this request: the challenge still breaks it after two revisions, or shape was blocked. Revise it with your answer, build the last version as it stands, or drop it?" },
          "choices": { "value": ["revise", "build as is", "drop"] },
          "issue": "context.issue", "challenge": "context.challenge", "failure": "context.failure"
        },
        "onDone": [
          { "target": "shaping", "guard": "revise", "description": "the answer's words go to shape; one more round", "actions": [{ "type": "set", "params": { "answer": "event.output", "failure": { "value": null } } }] },
          { "target": "fixing", "guard": "buildAsIs", "description": "build the last issue as it stands", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] },
          { "target": "dropped", "actions": [{ "type": "set", "params": { "decision": "event.output" } }] }
        ],
        "onError": "dropped"
      }
    },
    "fixing": {
      "meta": { "needs": ["hasIssue"] },
      "invoke": {
        "id": "fix", "src": "quick-fix",
        "input": { "issue": "context.issue" },
        "onDone": { "target": "done", "actions": [{ "type": "set", "params": { "fix": "event.output" } }] },
        "onError": { "target": "dropped", "actions": [{ "type": "set", "params": { "failure": "event.error" } }] }
      }
    },
    "done": { "type": "final" },
    "dropped": { "type": "final" }
  },
  "meta": {
    "delays": { "checkBack": 3600000 },
    "guards": {
      "hasRequest": ["context.request.url", "context.request.text"],
      "hasIssue": ["context.issue.expect"],
      "passed": [{ "path": "event.output.result", "in": ["PASS"] }],
      "reviseAgain": [{ "path": "event.output.result", "in": ["FAIL"] }, { "path": "context.rerevised", "in": [null] }],
      "revise": [{ "path": "event.output.choice", "in": ["revise"] }, "event.output.why"],
      "buildAsIs": [{ "path": "event.output.choice", "in": ["build as is"] }, "context.issue.expect"]
    },
    "input": {
      "type": "object",
      "required": ["request"],
      "properties": {
        "request": { "$ref": "#request" }
      }
    },
    "actors": {
      "shape": {
        "prompt": "intake/shape.md",
        "type": "object", "oneOf": [{ "required": ["issue"] }, { "required": ["blocked"] }],
        "properties": {
          "issue": { "$ref": "#shaped" },
          "blocked": { "type": "object", "required": ["reason"], "properties": { "reason": { "type": "string", "minLength": 1 } } }
        }
      },
      "challenge": {
        "prompt": "intake/challenge.md",
        "type": "object", "required": ["result", "lines", "wrong_build"],
        "properties": {
          "result": { "enum": ["PASS", "FAIL"] },
          "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#line" }, "covers": "issue.expect" },
          "wrong_build": { "type": "string", "minLength": 1 }
        }
      },
      "ask": { "type": "object", "required": ["choice", "by"], "properties": { "choice": { "type": "string" }, "by": { "type": "string", "minLength": 1 }, "why": { "type": "string" } } }
    },
    "schemas": {
      "request": { "type": "object", "required": ["url", "text"], "properties": { "url": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } },
      "shaped": {
        "type": "object", "required": ["title", "problem", "reason", "outcome", "expect", "proofs", "non_goals", "assumptions"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "expect": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "proofs": { "type": "array", "minItems": 1, "items": { "$ref": "#proof" } },
          "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      },
      "proof": { "type": "object", "required": ["line", "proof", "how"], "properties": { "line": { "type": "string", "minLength": 1 }, "proof": { "enum": ["run", "ci", "read"] }, "how": { "type": "string", "minLength": 1 } } },
      "line": { "type": "object", "required": ["line", "result", "evidence"], "properties": { "line": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] }, "evidence": { "type": "string", "minLength": 1 } } }
    }
  }
}
