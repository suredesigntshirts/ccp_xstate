{
  "id": "intake",
  "description": "One request to a frozen issue, then one quick-fix child item. Shape writes the issue; challenge, seeing only the request and the issue, tries to break it before anything is built; shape revises at most twice before the card (plan/decisions/2026-11-05-wf-intake-ready.md).",
  "initial": "shaping",
  "context": {
    "request": null,
    "issue": null,
    "challenge": null,
    "answer": null,
    "failure": null,
    "failed1": null,
    "failed2": null,
    "failed3": null,
    "fix": null,
    "decision": null
  },
  "output": {
    "issue": "context.issue",
    "challenge": "context.challenge",
    "fix": "context.fix"
  },
  "states": {
    "shaping": {
      "meta": {
        "needs": [
          "hasRequest"
        ]
      },
      "invoke": {
        "id": "shape",
        "src": "shape",
        "input": {
          "task": {
            "value": "Read the request, then the repository it is about, and write the issue. Find what is really there: the files, exports, scripts and tests the request touches, and any place where what is asked is already half true or already broken. Write one expect line for each fact a correct pull request must make true, including a regression check when the request reports a bug, and nothing a wrong pull request could satisfy while missing the outcome. Prefer proof run; use read only for wording or documentation. If challenge is set, your last version failed it: fix every FAIL line it names, and add the line its wrong build shows is missing. If answer is set, follow its words."
          },
          "request": "context.request",
          "challenge": "context.challenge",
          "answer": "context.answer"
        },
        "onDone": {
          "target": "challenging",
          "description": "the host sets the issue's url from the request's",
          "actions": [
            {
              "type": "set",
              "params": {
                "issue": "event.output.issue",
                "issue.url": "context.request.url"
              }
            }
          ]
        },
        "onError": {
          "target": "stuck",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": "event.error"
              }
            }
          ]
        }
      }
    },
    "challenging": {
      "meta": {
        "needs": [
          "hasIssue"
        ]
      },
      "invoke": {
        "id": "challenge",
        "src": "challenge",
        "input": {
          "task": {
            "value": "Read the request and the issue, then the repository. Write down what a correct pull request must do for the request, before you read the expect lines closely. Then, for each expect line, try to build a wrong pull request that meets it: one that satisfies its words while missing the request (a half-met rule the repository already breaks, a fix that hides the symptom, a change with no regression test), one that two readers would grade differently, or one whose proof only shows after merge. Check every assumption against the request: an assumption that changes what was asked fails the line that rests on it. Last, try for one wrong build that meets every line at once."
          },
          "request": "context.request",
          "issue": "context.issue"
        },
        "onDone": [
          {
            "target": "fixing",
            "guard": "passed",
            "description": "every expect line held: the issue is frozen",
            "actions": [
              {
                "type": "set",
                "params": {
                  "challenge": "event.output",
                  "failure": {
                    "value": null
                  }
                }
              }
            ]
          },
          {
            "target": "shaping",
            "guard": "revisionLeft",
            "description": "FAIL with a revision left: shape again with this challenge. failed1..3 shift once per FAIL, so failed3 is set by the third",
            "actions": [
              {
                "type": "set",
                "params": {
                  "challenge": "event.output",
                  "failed3": "context.failed2",
                  "failed2": "context.failed1",
                  "failed1": {
                    "value": true
                  }
                }
              }
            ]
          },
          {
            "target": "stuck",
            "description": "FAIL after two revisions",
            "actions": [
              {
                "type": "set",
                "params": {
                  "challenge": "event.output"
                }
              }
            ]
          }
        ],
        "onError": {
          "target": "stuck",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": "event.error"
              }
            }
          ]
        }
      }
    },
    "stuck": {
      "after": {
        "checkBack": {
          "description": "no answer an hour after the ask: nothing moves; the wake brings the thread back to the waiting item (fix-waiting-wake)"
        }
      },
      "invoke": {
        "id": "ask",
        "src": "ask",
        "input": {
          "question": {
            "value": "Intake could not freeze an issue for this request: the challenge still breaks it after two revisions, or shape was blocked. Revise it with your answer, build the last version as it stands, or drop it?"
          },
          "choices": {
            "value": [
              "revise",
              "build as is",
              "drop"
            ]
          },
          "issue": "context.issue",
          "challenge": "context.challenge",
          "failure": "context.failure"
        },
        "onDone": [
          {
            "target": "shaping",
            "guard": "revise",
            "description": "the answer's words go to shape; one more round",
            "actions": [
              {
                "type": "set",
                "params": {
                  "answer": "event.output",
                  "failure": {
                    "value": null
                  }
                }
              }
            ]
          },
          {
            "target": "fixing",
            "guard": "buildAsIs",
            "description": "build the last issue as it stands",
            "actions": [
              {
                "type": "set",
                "params": {
                  "decision": "event.output"
                }
              }
            ]
          },
          {
            "target": "dropped",
            "guard": "drop",
            "actions": [
              {
                "type": "set",
                "params": {
                  "decision": "event.output"
                }
              }
            ]
          }
        ],
        "onError": "dropped"
      }
    },
    "fixing": {
      "meta": {
        "needs": [
          "hasIssue"
        ]
      },
      "invoke": {
        "id": "fix",
        "src": "quick-fix",
        "input": {
          "issue": "context.issue"
        },
        "onDone": {
          "target": "done",
          "actions": [
            {
              "type": "set",
              "params": {
                "fix": "event.output"
              }
            }
          ]
        },
        "onError": {
          "target": "dropped",
          "actions": [
            {
              "type": "set",
              "params": {
                "failure": "event.error"
              }
            }
          ]
        }
      }
    },
    "done": {
      "type": "final"
    },
    "dropped": {
      "type": "final"
    }
  },
  "meta": {
    "delays": {
      "checkBack": 3600000
    },
    "guards": {
      "hasRequest": [
        "context.request.url",
        "context.request.text"
      ],
      "hasIssue": [
        "context.issue.expect"
      ],
      "passed": [
        {
          "path": "event.output.result",
          "in": [
            "PASS"
          ]
        }
      ],
      "revisionLeft": [
        {
          "path": "event.output.result",
          "in": [
            "FAIL"
          ]
        },
        {
          "path": "context.failed3",
          "in": [
            null
          ]
        }
      ],
      "revise": [
        {
          "path": "event.output.choice",
          "in": [
            "revise"
          ]
        },
        "event.output.why"
      ],
      "drop": [
        {
          "path": "event.output.choice",
          "in": [
            "drop"
          ]
        }
      ],
      "buildAsIs": [
        {
          "path": "event.output.choice",
          "in": [
            "build as is"
          ]
        },
        "context.issue.expect"
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#request"
        }
      }
    },
    "actors": {
      "shape": {
        "rules": [
          "You are the issue writer. You turn one request into the issue a builder will build and an independent verifier will check, before anything is built. You read the repository to ground the issue in what is really there, and you change nothing.",
          "Write no code, commits, branches, pull requests or comments; do not create or edit a GitHub issue.",
          "State the problem, not a fix: keep a way of fixing it out of the expect lines unless the request makes it a requirement (a named function, file or command the request asks for); a fix the request only suggests goes under assumptions.",
          "Every expect line must be checkable at the pull request's head before it merges, by one reader, with one answer. A line only checkable after merge (a release, a deploy, a published page) is rewritten as what the pull request itself must contain, or moved to the outcome or non_goals.",
          "Where the request is open, take the default a careful maintainer would and record it under assumptions; do not stop to ask.",
          "If the request is not one change to this repository (a question, or several unrelated changes), return blocked with the reason instead of an issue.",
          "Return once the issue is written. It is checked by an independent challenger, and if it fails you get its findings and write it again."
        ],
        "inputs": {
          "task": "The issue writer's job, fixed in the workflow. It fills the Task part.",
          "request": "What was asked: url is where it came from (a GitHub issue or the person's message) and text is its words. The text is the only statement of what is wanted; it may be vague, prescribe a fix, or ask for things that can only be seen after merge.",
          "challenge": "The challenger's verdict on your last version of the issue: per expect line, PASS or FAIL with evidence, and the strongest wrong build it found. null on the first round.",
          "answer": "The person's answer from the card, when an earlier round could not be settled: their choice, and in why their words. null when there is none. Their words outrank your assumptions."
        },
        "type": "object",
        "oneOf": [
          {
            "required": [
              "issue"
            ]
          },
          {
            "required": [
              "blocked"
            ]
          }
        ],
        "properties": {
          "issue": {
            "$ref": "#shaped",
            "description": "The issue: title; problem (what is wrong or missing now, as observed in the repository, with no fix); reason (why it matters); outcome (what is true when it is done); expect (the acceptance lines, each one checkable fact); proofs (one entry per expect line, in the same order: line copied exactly, proof run, ci or read, and how: the command to run, the CI check to read, or the file to read); non_goals (what this issue does not ask for); assumptions (each default you took where the request was open)."
          },
          "blocked": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Only when the request is not one change to this repository: { reason }."
          }
        }
      },
      "challenge": {
        "rules": [
          "You are the challenger. Your job is to break an issue before anyone builds it: you look for a pull request that would meet every expect line and still be wrong. You did not write the issue, and the writer's reasoning is not yours to rely on.",
          "Read the repository to find real ways a build could go wrong; change nothing. Write no code, commits, branches, pull requests or comments.",
          "FAIL a line when a wrong build meets it, when two careful readers could check it at the same commit and disagree, or when it can only be checked after merge. PASS a line only when you tried to break it and could not.",
          "If a wrong build meets every line, a line is missing: FAIL the line nearest to what that build gets wrong, and say in its evidence which line is missing.",
          "Do not FAIL a line for style, wording you would prefer, a stricter test its words do not need, or a wrong build only a builder set on gaming the line would make (a skipped test, deleting what the request did not touch); FAIL for the mistakes and shortcuts a careful builder could make in good faith.",
          "Return once every expect line has an entry."
        ],
        "inputs": {
          "task": "The challenger's job, fixed in the workflow. It fills the Task part.",
          "request": "What was asked: url is where it came from and text is its words. The issue must deliver what the text asks, no less and no more.",
          "issue": "The issue to challenge: title, problem, reason, outcome, expect (the acceptance lines), proofs (how each line is to be checked: run, ci or read), non_goals and assumptions. The expect lines are what you judge."
        },
        "type": "object",
        "required": [
          "result",
          "lines",
          "wrong_build"
        ],
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ],
            "description": "PASS only if every entry in lines is PASS; otherwise FAIL."
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#line"
            },
            "covers": "issue.expect",
            "description": "One entry per expect line, in order: { line: the expect line copied exactly, result: PASS or FAIL, evidence: for FAIL, the wrong build that meets it, the two readings, or why it can only be checked after merge; for PASS, the strongest wrong build you tried and why the line catches it }. The host refuses a result that misses a line, adds one, puts them out of order, or whose result disagrees with these entries."
          },
          "wrong_build": {
            "type": "string",
            "minLength": 1,
            "description": "The strongest pull request you found that meets every expect line and is still wrong against the request, the problem or the outcome, and what it gets wrong; or, if you found none, the closest you came and which line stopped it."
          }
        }
      },
      "quick-fix": {
        "type": "object",
        "required": [
          "issue"
        ],
        "properties": {
          "issue": {
            "type": "object"
          }
        }
      },
      "ask": {
        "type": "object",
        "required": [
          "choice",
          "by"
        ],
        "properties": {
          "choice": {
            "type": "string"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "schemas": {
      "request": {
        "type": "object",
