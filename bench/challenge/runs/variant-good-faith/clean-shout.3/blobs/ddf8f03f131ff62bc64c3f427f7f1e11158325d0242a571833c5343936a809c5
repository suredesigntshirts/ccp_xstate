            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "proof": {
        "type": "object",
        "required": [
          "line",
          "proof",
          "how"
        ],
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "enum": [
              "run",
              "ci",
              "read"
            ]
          },
          "how": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "line": {
        "type": "object",
        "required": [
          "line",
          "result",
          "evidence"
        ],
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
