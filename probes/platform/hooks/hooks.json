{
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/slow-hook.sh\" SessionStart" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/slow-hook.sh\" PreToolUse" } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" PermissionDenied" } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-hook.sh\" PostToolUseFailure" } ] }
    ]
  }
}
