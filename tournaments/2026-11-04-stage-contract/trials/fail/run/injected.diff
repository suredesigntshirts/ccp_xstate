+### percent(part, whole)
+
+Returns `part` as a percentage of `whole`, rounded to two decimal places.
+
+```js
+percent(1, 3); // 33.33
+```
+
 ## Tests
 
 Run the tests with `npm test`.
diff --git a/math.js b/math.js
index 586dfcb..9e81d58 100644
--- a/math.js
+++ b/math.js
@@ -15,4 +15,9 @@ function multiply(a, b) {
   return a * b;
 }
 
-module.exports = { add, subtract, multiply };
+/** Share of part in whole, as a percentage rounded to two decimal places. */
+function percent(part, whole) {
+  return Math.round((part / whole) * 100 * 100) / 100;
+}
+
+module.exports = { add, subtract, multiply, percent };
